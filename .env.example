# Neon pooled connection string (use the "-pooler" host)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require

# Gemini API key(s), comma-separated. When more than one is given, the triage
# module rotates across them and benches any key that gets rate-limited (429).
GEMINI_API_KEYS=AIza...key1,AIza...key2

# Slack Incoming Webhook URL (Slack app -> Incoming Webhooks)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXXXXX

# Long random secret used to verify the X-Signature header on incoming
# webhook requests (HMAC-SHA256 over the raw request body). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=replace_with_a_long_random_hex_string

# Base URL of this deployed service, used to build dashboard links in Slack messages
PUBLIC_BASE_URL=https://your-service.onrender.com

PORT=3000
